{
  "name": "huanyu-mvp",
  "private": true,
  "version": "0.1.0",
  "description": "寰宇医道 MVP - 无感采集 + 无感回填",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "backend:dev": "pnpm --filter backend dev",
    "backend:build": "pnpm --filter backend build",
    "android:install": "cd packages/android-app && JAVA_HOME=/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home ./gradlew installDebug",
    "net:mobile:auto": "node scripts/switch-mobile-network.js",
    "net:mobile:set": "node scripts/switch-mobile-network.js",
    "tray:dev": "pnpm --filter tray-app dev",
    "ext:build": "pnpm --filter extension build",
    "db:migrate": "pnpm --filter backend db:migrate",
    "db:seed": "pnpm --filter backend db:seed",
    "deploy:win": "node scripts/deploy-win.js",
    "package:win": "node scripts/build-installer-win.js",
    "sidecar:build:win": "node scripts/build-sidecar-win.js"
  },
  "devDependencies": {
    "ssh2": "^1.17.0",
    "typescript": "^5.4.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild"
    ]
  }
}
