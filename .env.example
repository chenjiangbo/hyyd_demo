# Windows 虚拟机 SSH 部署配置
WIN_VM_HOST=192.168.202.128
WIN_VM_PORT=22
WIN_VM_USERNAME=chenjiangbo
WIN_VM_PASSWORD=your_password_here
WIN_VM_TARGET_DIR=C:\Users\chenjiangbo\hyyd_demo
# VLM layout detection for WeChat/WeCom window regions. Required by tray app capture.
HYYD_VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
HYYD_VLM_API_KEY=your_vlm_api_key_here
HYYD_VLM_MODEL=gui-plus

# 后端服务配置
PORT=13000
HOST=0.0.0.0
DATABASE_URL=postgresql://huanyu:huanyu_dev_pwd@localhost:15432/huanyu

# MinIO: 后端本机访问地址
MINIO_HOST=localhost
MINIO_PORT=19000
MINIO_ACCESS_KEY=huanyu
MINIO_SECRET_KEY=huanyu_dev_pwd
MINIO_BUCKET_RECORDINGS=recordings
MINIO_BUCKET_SCREENSHOTS=screenshots

# MinIO: 返回给手机 / Windows VM 的 presigned URL 地址
MINIO_PUBLIC_HOST=192.168.21.96
MINIO_PUBLIC_PORT=19000

# 阿里云 MySQL/MariaDB 远端字典库：仅供寰宇订单下拉框读取。
# 请使用只读账号；应用代码只会执行固定的参数化 SELECT。
REMOTE_DICT_DB_HOST=your-rds-host
REMOTE_DICT_DB_PORT=3306
REMOTE_DICT_DB_NAME=your-dictionary-database
REMOTE_DICT_DB_USER=your-readonly-user
REMOTE_DICT_DB_PASSWORD=your-readonly-password
REMOTE_DICT_DB_SSL=false

# 寰宇订单人工确认推送目标 MySQL。建议使用只具有 HY_FACT_DDCX_NEW、
# fact_hy_pzrxx、hy_d_tp 三张表写权限的独立账号；未设置时后端兼容使用上方 REMOTE_DICT_DB_*。
HUANYU_PUSH_DB_HOST=your-rds-host
HUANYU_PUSH_DB_PORT=3306
HUANYU_PUSH_DB_NAME=your-huanyu-database
HUANYU_PUSH_DB_USER=your-huanyu-writer
HUANYU_PUSH_DB_PASSWORD=your-password-here
HUANYU_PUSH_DB_SSL=false
