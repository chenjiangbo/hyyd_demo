POSTGRES_DB=huanyu
POSTGRES_USER=huanyu
POSTGRES_PASSWORD=change-me-postgres

MINIO_ROOT_USER=huanyu
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_PUBLIC_HOST=your-server-host-or-ip
MINIO_PUBLIC_PORT=19000
MINIO_BUCKET_RECORDINGS=recordings
MINIO_BUCKET_SCREENSHOTS=screenshots

HOST=0.0.0.0
PORT=13000

ADMIN_PASSWORD=change-me-admin-password
ADMIN_JWT_SECRET=change-me-long-random-jwt-secret

# ── 百炼 AI 配置 ──────────────────────────────────────────────────────────────
# 文本 AI、语音转写（固定使用 fun-asr）共用的百炼 API Key。
# 用于订单 AI 分析、摘要、字段提取和语音转写；视觉模型未配置专用 Key 时也会回退使用它。
# 包含 $ 等特殊字符时请保留单引号；单引号本身不会成为 Key 的一部分。
DASHSCOPE_API_KEY='change-me-dashscope-key'

# 文本 AI 的 OpenAI 兼容 Base URL。生产建议填写业务空间弹窗中“OpenAI 兼容地址”的完整值；
# 不要追加 /chat/completions（后端会自动追加）。未配置时，后端默认回退到
# https://dashscope.aliyuncs.com/compatible-mode/v1。
HYYD_LLM_BASE_URL=https://your-workspace-id.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# 文本 AI 模型：用于订单 AI 分析、摘要和字段提取；未配置时，后端默认 qwen-plus。
# 仅处理文本，不用于身份证或订单图片识别。
HYYD_LLM_MODEL=qwen-plus

# 视觉 AI 专用 Key：用于身份证附件 OCR、订单图片素材的文字提取和分类。
# 未配置或留空时，后端默认回退使用 DASHSCOPE_API_KEY。
HYYD_VLM_API_KEY='change-me-vlm-api-key'

# 视觉 AI 的 OpenAI 兼容 Base URL；填写业务空间弹窗中“OpenAI 兼容地址”的完整值。
# 不要追加 /chat/completions（后端会自动追加）；未配置时，代码默认回退到
# https://dashscope.aliyuncs.com/compatible-mode/v1。
HYYD_VLM_BASE_URL=https://your-workspace-id.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# 视觉 AI 模型。未配置时，代码默认 qwen-vl-max；生产建议显式固定为已验证、已授权的
# qwen-vl-ocr-2025-11-20，避免平台别名更新或权限差异影响身份证 OCR 结果。
HYYD_VLM_MODEL=qwen-vl-ocr-2025-11-20

# 以下为历史自建网关配置，仅供少量流式聊天/异步 Job 调用；普通订单 AI 分析、ASR 和
# 视觉 OCR 都不使用它们。未调用这些历史能力时可保持占位值。
GATEWAY_BASE_URL=https://your-gateway.example.com
GATEWAY_APP_ID=hyyd-demo
GATEWAY_API_KEY='change-me-gateway-key'

# 阿里云 MySQL/MariaDB 远端字典库：仅供寰宇订单下拉框读取。
# 请使用只读账号；应用代码只会执行固定的参数化 SELECT。
REMOTE_DICT_DB_HOST=your-rds-host
REMOTE_DICT_DB_PORT=3306
REMOTE_DICT_DB_NAME=your-dictionary-database
REMOTE_DICT_DB_USER=your-readonly-user
REMOTE_DICT_DB_PASSWORD=your-readonly-password
REMOTE_DICT_DB_SSL=false

# ABI 挂号退款。以下四项均为后端启动必填配置，appsecret 仅保存在后端环境变量。
ABI_REFUND_AUTH_URL=http://your-abi-host/abi/api/token/sign
ABI_REFUND_URL=http://your-abi-host/abi/order/aliPayRefund
ABI_REFUND_APP_ID=your-abi-appid
ABI_REFUND_APP_SECRET=your-abi-appsecret
