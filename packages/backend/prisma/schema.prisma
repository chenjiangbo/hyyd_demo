datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Employee {
  id                      Int                      @id @default(autoincrement())
  name                    String
  phone                   String
  wechatId                String?                  @map("wechat_id")
  taikangAccount          String?                  @map("taikang_account")
  token                   String                   @unique
  password                String?                  @map("PASSWORD")
  enabled                 Int                      @default(1) @map("ENABLED")
  orders                  Order[]
  messages                Message[]
  calls                   Call[]
  materials               Material[]
  unmatchedOrderRefs      UnmatchedOrderRef[]
  taikangFormSessions      TaikangFormSession[]
  nativeChatConversations  NativeChatConversation[]
  mobileClientStates      MobileClientState[]

  @@map("employees")
}

model TaikangFormSession {
  id                String             @id @db.Uuid
  employeeId        Int                @map("employee_id")
  employee          Employee           @relation(fields: [employeeId], references: [id])
  taikangAccount    String             @map("taikang_account")
  taikangUserId     Int                @map("taikang_user_id")
  routeKind         String             @map("route_kind")
  sourceOrderNo     String?            @map("source_order_no")
  serviceName       String?            @map("service_name")
  startedAt         DateTime           @db.Timestamp(3) @map("started_at")
  lastEventAt       DateTime           @db.Timestamp(3) @map("last_event_at")
  endedAt           DateTime?          @db.Timestamp(3) @map("ended_at")
  eventCount        Int                @default(0) @map("event_count")
  events            TaikangFormEvent[]

  @@index([startedAt(sort: Desc), id(sort: Desc)])
  @@index([employeeId, startedAt(sort: Desc)])
  @@index([sourceOrderNo, startedAt(sort: Desc)])
  @@map("taikang_form_sessions")
}

model TaikangFormEvent {
  id          String             @id @db.Uuid
  sessionId   String             @db.Uuid @map("session_id")
  session     TaikangFormSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sequence    Int
  occurredAt  DateTime           @db.Timestamp(3) @map("occurred_at")
  kind        String
  payload     Json
  payloadHash String             @map("payload_hash")
  receivedAt  DateTime           @default(now()) @db.Timestamp(3) @map("received_at")

  @@unique([sessionId, sequence])
  @@index([sessionId, occurredAt])
  @@map("taikang_form_events")
}

model Order {
  id                      Int                      @id @default(autoincrement())
  source                  String // 'taikang' | 'pingan'
  sourceCategory          String?                  @map("source_category") // 工作台来源分类：泰康挂号/泰康绿通/寰宇自营
  sourceOrderNo           String                   @map("source_order_no")
  customerName            String                   @map("customer_name")
  customerPhone           String?                  @map("customer_phone")
  hospital                String?
  dept                    String?
  doctor                  String?
  status                  String                   @default("候选") // 泰康 orderStateName 原文，如"待处理 / 待就诊 / 待支付 / 已完成"。默认值留旧文案仅作迁移兼容。
  assignedEmployeeId      Int?                     @map("assigned_employee_id")
  assignedEmployee        Employee?                @relation(fields: [assignedEmployeeId], references: [id])
  rawJson                 Json?                    @map("raw_json")
  detailJson              Json?                    @map("detail_json")
  detailFetchedAt         DateTime?                @db.Timestamp(3) @map("detail_fetched_at")
  detailFingerprint       String?                  @map("detail_fingerprint") // 插件算的状态指纹，用于增量基线
  orderState              String?                  @map("order_state") // 泰康订单状态码原值，用于检测状态变化
  huanyuOrderNo           String?                  @unique @map("huanyu_order_no") // 对应 HY_FACT_DDCX_NEW.DDBH；创建后不再改变
  // AI 滚动简报（综合微信/企微消息 + 通话/录音转写，一次调用产出 摘要/阶段/待办/风险/回填关键信息）
  // 见 docs/设计_订单AI滚动简报.md。aiBriefJson 存整份简报；brief* 是增量水位。
  aiBriefJson             Json?                    @map("ai_brief_json")
  briefUpdatedAt          DateTime?                @db.Timestamp(3) @map("brief_updated_at")
  briefLastMsgId          Int?                     @map("brief_last_msg_id") // 上次处理到的最大 Message.id
  briefLastNativeAt       DateTime?                @map("brief_last_native_at")
  briefLastCallId         Int?                     @map("brief_last_call_id") // 上次处理到的最大 Call.id
  briefLastMaterialId     Int?                     @map("brief_last_material_id") // 上次处理到的最大 Material.id（手工补录）
  // 字段/服务步骤分析的独立水位。无论一次分析成功还是失败都会推进，避免同一批素材被后台重复调用。
  // 旧 brief* 水位仍只服务旧版“AI 简报”页面，二者不得混用。
  fieldAiLastMsgId        Int?                     @map("field_ai_last_msg_id")
  fieldAiLastNativeAt     DateTime?                @map("field_ai_last_native_at")
  fieldAiLastCallId       Int?                     @map("field_ai_last_call_id")
  fieldAiLastMaterialId   Int?                     @map("field_ai_last_material_id")
  createdAt               DateTime                 @default(now()) @db.Timestamp(3) @map("created_at")
  poolEnteredAt           DateTime?                @db.Timestamp(3) @map("pool_entered_at") // 仅泰康订单填写；自营订单留空
  updatedAt               DateTime                 @updatedAt @db.Timestamp(3) @map("updated_at")
  messages                Message[]
  calls                   Call[]
  aiSummaries             AiSummary[]
  attachments             OrderAttachment[]
  idCardOcrAttempt         OrderIdCardOcrAttempt?
  greenPassIdCardJob       GreenPassIdCardJob?
  greenPassSyncRetry       GreenPassSyncRetry?
  materials               Material[]
  statusHistory           OrderStatusHistory[]

  @@unique([source, sourceOrderNo])
  @@index([assignedEmployeeId, createdAt(sort: Desc), id(sort: Desc)], map: "orders_employee_created_id_idx")
  @@map("orders")
}

// 个人池订单与后台已有归属不一致时留痕；不修改原订单归属。
model OrderAttributionMismatch {
  id                     Int       @id @default(autoincrement())
  sourceOrderNo          String    @map("source_order_no")
  storedEmployeeId       Int       @map("stored_employee_id")
  observedEmployeeId     Int       @map("observed_employee_id")
  observedTaikangAccount String    @map("observed_taikang_account")
  observedTaikangUserId  Int       @map("observed_taikang_user_id")
  batchId                String    @map("batch_id")
  observedAt             DateTime  @default(now()) @db.Timestamp(3) @map("observed_at")

  @@unique([batchId, sourceOrderNo])
  @@index([observedAt(sort: Desc)])
  @@map("order_attribution_mismatches")
}

model ApplicationBrief {
  id              Int       @id @default(autoincrement())
  applicationNo   String    @unique @map("application_no")
  briefJson       Json?     @map("brief_json")
  briefUpdatedAt  DateTime? @db.Timestamp(3) @map("brief_updated_at")
  briefLastMsgId  Int?      @map("brief_last_msg_id")
  briefLastNativeAt DateTime? @map("brief_last_native_at")
  briefLastCallId Int?      @map("brief_last_call_id")
  createdAt       DateTime  @default(now()) @db.Timestamp(3) @map("created_at")
  updatedAt       DateTime  @updatedAt @db.Timestamp(3) @map("updated_at")

  @@map("application_briefs")
}

// 订单状态变更历史：每当 orderState 变化（含首次出现）记一条，
// 用于追溯订单在个人池里的状态流转。
model OrderStatusHistory {
  id             Int      @id @default(autoincrement())
  orderId        Int      @map("order_id")
  order          Order    @relation(fields: [orderId], references: [id])
  orderState     String?  @map("order_state") // 状态码，如 "2002" / "8"
  orderStateName String?  @map("order_state_name") // 状态名，如 "待处理" / "待分配医学陪诊"
  recordedAt     DateTime @default(now()) @db.Timestamp(3) @map("recorded_at")

  @@index([orderId])
  @@map("order_status_history")
}

model OrderAttachment {
  id          Int      @id @default(autoincrement())
  orderId     Int      @map("order_id")
  order       Order    @relation(fields: [orderId], references: [id])
  fileType    String   @map("file_type")
  fileId      String   @map("file_id")
  fileName    String   @map("file_name")
  mimeType    String   @map("mime_type")
  minioBucket String   @map("minio_bucket")
  minioKey    String   @map("minio_key")
  byteSize    Int      @map("byte_size")
  rawJson     Json?    @map("raw_json")
  createdAt   DateTime @default(now()) @db.Timestamp(3) @map("created_at")

  @@unique([orderId, fileId])
  @@index([orderId])
  @@map("order_attachments")
}

// 一单最多自动调用一次身份证视觉识别；号码仅存本地 HY_FACT_DDCX_NEW.JZR_ZJHM。
model OrderIdCardOcrAttempt {
  orderId     Int      @id @map("order_id")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  attemptedAt DateTime @default(now()) @map("attempted_at") @db.Timestamp(6)
  result      String   @default("pending") @db.VarChar(24)

  @@map("order_id_card_ocr_attempts")
}

model GreenPassIdCardJob {
  orderId   Int      @id @map("order_id")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String   @default("pending") @db.VarChar(24)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamp(6)

  @@map("green_pass_id_card_jobs")
}

model GreenPassSyncRetry {
  orderId   Int      @id @map("order_id")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamp(6)

  @@map("green_pass_sync_retries")
}

// 现场采集版的核心数据：员工从微信/企微复制粘贴进来的素材。
// type=text 走 textContent；type=image 走 MinIO（bucket=materials）。
// clientUuid 由 tray-app 本地 sqlite 在落地时生成，
// 用 (orderId, clientUuid) 做幂等键，避免离线补传时双插。
model Material {
  id                 Int       @id @default(autoincrement())
  orderId            Int       @map("order_id")
  order              Order     @relation(fields: [orderId], references: [id])
  employeeId         Int       @map("employee_id")
  employee           Employee  @relation(fields: [employeeId], references: [id])
  type               String // 'text' | 'image'
  textContent        String?   @map("text_content")
  minioBucket        String?   @map("minio_bucket")
  minioKey           String?   @map("minio_key")
  mimeType           String?   @map("mime_type")
  byteSize           Int?      @map("byte_size")
  clientUuid         String    @map("client_uuid")
  // 图片素材的 AI 识图缓存（qwen-vl 分类 + OCR，识一次复用）。供订单 AI 简报使用。
  aiImageKind        String?   @map("ai_image_kind") // 聊天截图 / 单据 / 短信 / 其他
  aiImageText        String?   @map("ai_image_text") // 从图中提取的文字/关键信息
  aiImageProcessedAt DateTime? @db.Timestamp(3) @map("ai_image_processed_at")
  createdAt          DateTime  @default(now()) @db.Timestamp(3) @map("created_at")

  @@unique([orderId, clientUuid])
  @@index([orderId])
  @@map("materials")
}

model Message {
  id               Int      @id @default(autoincrement())
  orderId          Int?     @map("order_id")
  order            Order?   @relation(fields: [orderId], references: [id])
  applicationNo    String?  @map("application_no")
  channel          String // 'wechat' | 'wxwork'
  conversationName String   @map("conversation_name")
  senderName       String?  @map("sender_name")
  contentText      String   @map("content_text")
  screenshotOssKey String?  @map("screenshot_oss_key")
  capturedAt       DateTime @db.Timestamp(3) @map("captured_at")
  employeeId       Int      @map("employee_id")
  employee         Employee @relation(fields: [employeeId], references: [id])

  // 跨帧去重 + 时间链还原（sidecar 出结构化、tray 逐帧转发、后端做跨帧处理）：
  senderType  String    @default("other") @map("sender_type") // self | other | system
  kind        String?   @map("kind") // system 细分：time | notice | other
  chatTime    DateTime? @db.Timestamp(3) @map("chat_time") // 时间锚点折算的真实聊天时间；算不出为 null（透明保留"是否估算"）
  sortTime    DateTime? @db.Timestamp(3) @map("sort_time") // 排序键 = chatTime ?? capturedAt；时间线统一按它排
  contentHash String?   @map("content_hash") // 归一内容哈希
  dedupeKey   String?   @unique @map("dedupe_key") // 员工+会话名+说话人+内容哈希 → 跨帧去重
  seenCount   Int       @default(1) @map("seen_count") // 同一条消息被截到的次数
  firstSeenAt DateTime? @db.Timestamp(3) @map("first_seen_at") // 首次截到
  lastSeenAt  DateTime? @db.Timestamp(3) @map("last_seen_at") // 最近截到

  @@index([orderId, sortTime])
  @@index([employeeId, applicationNo, sortTime])
  @@map("messages")
}

/// Canonical conversation records populated by native WeChat/WeCom adapters.
/// Screenshot-era Message rows remain separate and are not used as the new ingest contract.
model NativeChatConversation {
  id                   Int                  @id @default(autoincrement())
  employeeId           Int                  @map("employee_id")
  employee             Employee             @relation(fields: [employeeId], references: [id])
  channel              String
  accountId            String               @map("account_id")
  sourceConversationId String               @map("source_conversation_id")
  title                String?
  conversationKind     String               @default("unknown") @map("conversation_kind")
  businessCategory     String               @default("") @map("business_category")
  applicationNo        String?              @map("application_no")
  applicationCandidate String?              @map("application_candidate")
  applicationLinkStatus String              @default("no_candidate") @map("application_link_status")
  applicationLinkedAt  DateTime?            @map("application_linked_at")
  sourceMetadata       Json?                @map("source_metadata")
  firstObservedAt      DateTime             @default(now()) @map("first_observed_at")
  lastObservedAt       DateTime             @default(now()) @map("last_observed_at")
  messages             NativeChatMessage[]

  @@unique([employeeId, channel, accountId, sourceConversationId], map: "native_chat_conversations_source_key")
  @@index([employeeId, channel, lastObservedAt(sort: Desc)], map: "native_chat_conversations_recent_idx")
  @@index([applicationNo], map: "native_chat_conversations_application_no_idx")
  @@map("native_chat_conversations")
}

/// Platform-neutral message envelope. sourceTypeCode/sourceMetadata preserve source details
/// while kind and direction provide a stable application-level vocabulary.
model NativeChatMessage {
  id                    Int                      @id @default(autoincrement())
  conversationId        Int                      @map("conversation_id")
  conversation          NativeChatConversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sourceMessageId       String                   @map("source_message_id")
  parentSourceMessageId String?                  @map("parent_source_message_id")
  sourceItemIndex       Int?                     @map("source_item_index")
  direction             String                   @default("unknown")
  senderId              String?                  @map("sender_id")
  senderName            String?                  @map("sender_name")
  kind                  String
  sourceTypeCode        String?                  @map("source_type_code")
  text                  String?
  occurredAt            DateTime                 @map("occurred_at")
  observedAt            DateTime                 @map("observed_at")
  sourceMetadata        Json?                    @map("source_metadata")
  attachments           NativeChatAttachment[]

  @@unique([conversationId, sourceMessageId], map: "native_chat_messages_source_key")
  @@index([conversationId, occurredAt, sourceItemIndex], map: "native_chat_messages_timeline_idx")
  @@index([kind, occurredAt], map: "native_chat_messages_kind_time_idx")
  @@map("native_chat_messages")
}

/// Media bytes are tracked independently so unavailable or not-yet-downloaded content
/// remains an explicit state instead of being represented as a missing message.
model NativeChatAttachment {
  id               Int             @id @default(autoincrement())
  messageId        Int             @map("message_id")
  message          NativeChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  sourceAttachmentId String        @map("source_attachment_id")
  kind             String
  fileName         String?         @map("file_name")
  mimeType         String?         @map("mime_type")
  byteSize         BigInt?          @map("byte_size")
  contentHash      String?         @map("content_hash")
  state            String
  storageKey       String?         @map("storage_key")
  sourceMetadata   Json?           @map("source_metadata")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@index([messageId], map: "native_chat_attachments_message_idx")
  @@index([contentHash], map: "native_chat_attachments_hash_idx")
  @@unique([messageId, sourceAttachmentId], map: "native_chat_attachments_source_key")
  @@map("native_chat_attachments")
}

/// 待客户确认的订单号引用：截图标题里确实抽到了订单号候选（COD/fwyy…），
/// 但在该员工订单里模糊匹配不到（none）或并列多单（ambiguous）时，存这里给前端列出、
/// 让员工/客户确认绑定到哪张订单。UI 由另一端开发，本表只负责"存"。
/// 详见 docs/订单号待确认_交接说明.md。
model UnmatchedOrderRef {
  id                    Int      @id @default(autoincrement())
  employeeId            Int      @map("employee_id")
  employee              Employee @relation(fields: [employeeId], references: [id])
  channel               String // 'wechat' | 'wxwork'
  conversationName      String   @map("conversation_name") // OCR 到的会话标题原文
  candidate             String // 抽到的订单号候选（去空白后）
  candidateKind         String   @map("candidate_kind") // 'fwyy' | 'cod' | 'ccod' | 'od' | 'so' | 'lt' | 'tail8' | 'unknown'
  reason                String // 'no_match'（找不到） | 'ambiguous'（多单并列）
  bestDist              Int?     @map("best_dist") // 最近编辑距离（none 时是超阈值的最小值，便于排查）
  candidateOrderIds     Json?    @map("candidate_order_ids") // ambiguous 时并列的订单 id 列表
  screenshotOssKey      String?  @map("screenshot_oss_key")
  capturedAt            DateTime @db.Timestamp(3) @map("captured_at")
  seenCount             Int      @default(1) @map("seen_count") // 同一候选重复出现次数
  status                String   @default("pending") // 'pending' | 'confirmed' | 'rejected'
  resolvedOrderId       Int?     @map("resolved_order_id") // 确认时选择的订单（兼容/审计）
  resolvedApplicationNo String?  @map("resolved_application_no") // 确认后绑定的申领号
  note                  String?
  createdAt             DateTime @default(now()) @db.Timestamp(3) @map("created_at")
  updatedAt             DateTime @updatedAt @db.Timestamp(3) @map("updated_at")

  @@unique([employeeId, candidate], name: "employee_candidate")
  @@map("unmatched_order_refs")
}

model Call {
  id              Int       @id @default(autoincrement())
  orderId         Int?      @map("order_id")
  order           Order?    @relation(fields: [orderId], references: [id])
  applicationNo   String?   @map("application_no")
  employeeId      Int       @map("employee_id")
  employee        Employee  @relation(fields: [employeeId], references: [id])
  phone           String
  contactName     String?   @map("contact_name") // 通讯录里的姓名（移动端采集时带上，可能为空）
  direction       String // 'in' | 'out'
  callStatus      String    @default("answered") @map("call_status") // 'answered' | 'missed' | 'rejected' | 'outgoing_unanswered'
  durationSec     Int       @map("duration_sec")
  startedAt       DateTime  @db.Timestamp(3) @map("started_at")
  recordingOssKey String?   @map("recording_oss_key")
  recordingUploadedAt DateTime? @map("recording_uploaded_at")
  asrText         String?   @map("asr_text")
  asrStatus       String    @default("no_recording") @map("asr_status") // 'no_recording' | 'pending' | 'processing' | 'done' | 'failed' | 'requires_manual'
  // Fun-ASR (DashScope) 任务追踪
  dashscopeTaskId String?   @map("dashscope_task_id")
  asrResultJson   Json?     @map("asr_result_json")
  asrFinishedAt   DateTime? @db.Timestamp(3) @map("asr_finished_at")

  @@index([employeeId, applicationNo, startedAt])
  @@index([employeeId, recordingUploadedAt(sort: Desc)], map: "calls_employee_recording_uploaded_idx")
  @@map("calls")
}

/// Latest mobile collector runtime and synchronization state per employee installation.
model MobileClientState {
  id                     Int                 @id @default(autoincrement())
  employeeId             Int                 @map("employee_id")
  employee               Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  installationId         String              @map("installation_id")
  appVersion             String              @map("app_version")
  appVisibility          String              @default("unknown") @map("app_visibility")
  serviceRunning         Boolean             @default(false) @map("service_running")
  serviceStartedAt       DateTime?           @map("service_started_at")
  backgroundSince        DateTime?           @map("background_since")
  heartbeatSource        String              @map("heartbeat_source")
  lastHeartbeatAt        DateTime            @default(now()) @map("last_heartbeat_at")
  syncRunning            Boolean             @default(false) @map("sync_running")
  syncStartedAt          DateTime?           @map("sync_started_at")
  syncStage              String              @default("idle") @map("sync_stage")
  recordingsTotal        Int                 @default(0) @map("recordings_total")
  recordingsProcessed    Int                 @default(0) @map("recordings_processed")
  recordingsUploaded     Int                 @default(0) @map("recordings_uploaded")
  recordingsFailed       Int                 @default(0) @map("recordings_failed")
  currentRecordingName   String?             @map("current_recording_name")
  lastError              String?             @map("last_error")
  events                 MobileClientEvent[]

  @@unique([employeeId, installationId], map: "mobile_client_states_employee_installation_key")
  @@index([employeeId, lastHeartbeatAt(sort: Desc)], map: "mobile_client_states_employee_seen_idx")
  @@map("mobile_client_states")
}

/// Significant mobile collector transitions; routine heartbeat traffic is not duplicated here.
model MobileClientEvent {
  id          BigInt            @id @default(autoincrement())
  clientStateId Int              @map("client_state_id")
  clientState MobileClientState  @relation(fields: [clientStateId], references: [id], onDelete: Cascade)
  eventType   String             @map("event_type")
  details     Json?
  occurredAt  DateTime           @default(now()) @map("occurred_at")

  @@index([clientStateId, occurredAt(sort: Desc)], map: "mobile_client_events_state_time_idx")
  @@map("mobile_client_events")
}

model Command {
  id          Int       @id @default(autoincrement())
  target      String // 'ext' | 'tray'
  action      String // 'claim' | 'fill_form'
  payloadJson Json      @map("payload_json")
  status      String    @default("pending") // 'pending' | 'done' | 'failed' | 'requires_manual'
  createdAt   DateTime  @default(now()) @db.Timestamp(3) @map("created_at")
  executedAt  DateTime? @db.Timestamp(3) @map("executed_at")

  @@map("commands")
}

model AiSummary {
  id        Int      @id @default(autoincrement())
  orderId   Int      @map("order_id")
  order     Order    @relation(fields: [orderId], references: [id])
  callId    Int?     @map("call_id") // 关联到具体某次通话；message/full 类型可为 null
  type      String // 'call' | 'message' | 'full'
  content   String
  model     String
  createdAt DateTime @default(now()) @db.Timestamp(3) @map("created_at")

  @@index([callId])
  @@map("ai_summaries")
}
