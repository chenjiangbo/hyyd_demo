datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Employee {
  id             Int      @id @default(autoincrement())
  name           String
  phone          String
  wechatId       String?  @map("wechat_id")
  taikangAccount String?  @map("taikang_account")
  token          String   @unique
  orders         Order[]
  messages       Message[]
  calls          Call[]
  materials      Material[]

  @@map("employees")
}

model Order {
  id                 Int          @id @default(autoincrement())
  source             String       // 'taikang' | 'pingan'
  sourceOrderNo      String       @map("source_order_no")
  customerName       String       @map("customer_name")
  customerPhone      String?      @map("customer_phone")
  hospital           String?
  dept               String?
  doctor             String?
  status             String       @default("候选") // 泰康 orderStateName 原文，如"待处理 / 待就诊 / 待支付 / 已完成"。默认值留旧文案仅作迁移兼容。
  assignedEmployeeId Int?         @map("assigned_employee_id")
  assignedEmployee   Employee?    @relation(fields: [assignedEmployeeId], references: [id])
  rawJson            Json?        @map("raw_json")
  detailJson         Json?        @map("detail_json")
  detailFetchedAt    DateTime?    @map("detail_fetched_at")
  detailFingerprint  String?      @map("detail_fingerprint") // 插件算的状态指纹，用于增量基线
  orderState         String?      @map("order_state") // 泰康订单状态码原值，用于检测状态变化
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  messages           Message[]
  calls              Call[]
  aiSummaries        AiSummary[]
  attachments        OrderAttachment[]
  materials          Material[]
  statusHistory      OrderStatusHistory[]

  @@unique([source, sourceOrderNo])
  @@map("orders")
}

// 订单状态变更历史：每当 orderState 变化（含首次出现）记一条，
// 用于追溯订单在个人池里的状态流转。
model OrderStatusHistory {
  id             Int      @id @default(autoincrement())
  orderId        Int      @map("order_id")
  order          Order    @relation(fields: [orderId], references: [id])
  orderState     String?  @map("order_state")      // 状态码，如 "2002" / "8"
  orderStateName String?  @map("order_state_name") // 状态名，如 "待处理" / "待分配医学陪诊"
  recordedAt     DateTime @default(now()) @map("recorded_at")

  @@index([orderId])
  @@map("order_status_history")
}

model OrderAttachment {
  id          Int      @id @default(autoincrement())
  orderId     Int      @map("order_id")
  order       Order    @relation(fields: [orderId], references: [id])
  fileType    String   @map("file_type")
  fileId      String   @map("file_id")
  fileName    String   @map("file_name")
  mimeType    String   @map("mime_type")
  minioBucket String   @map("minio_bucket")
  minioKey    String   @map("minio_key")
  byteSize    Int      @map("byte_size")
  rawJson     Json?    @map("raw_json")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([orderId, fileId])
  @@index([orderId])
  @@map("order_attachments")
}

// 现场采集版的核心数据：员工从微信/企微复制粘贴进来的素材。
// type=text 走 textContent；type=image 走 MinIO（bucket=materials）。
// clientUuid 由 tray-app 本地 sqlite 在落地时生成，
// 用 (orderId, clientUuid) 做幂等键，避免离线补传时双插。
model Material {
  id           Int      @id @default(autoincrement())
  orderId      Int      @map("order_id")
  order        Order    @relation(fields: [orderId], references: [id])
  employeeId   Int      @map("employee_id")
  employee     Employee @relation(fields: [employeeId], references: [id])
  type         String   // 'text' | 'image'
  textContent  String?  @map("text_content")
  minioBucket  String?  @map("minio_bucket")
  minioKey     String?  @map("minio_key")
  mimeType     String?  @map("mime_type")
  byteSize     Int?     @map("byte_size")
  clientUuid   String   @map("client_uuid")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([orderId, clientUuid])
  @@index([orderId])
  @@map("materials")
}

model Message {
  id               Int      @id @default(autoincrement())
  orderId          Int?     @map("order_id")
  order            Order?   @relation(fields: [orderId], references: [id])
  channel          String   // 'wechat' | 'wxwork'
  conversationName String   @map("conversation_name")
  senderName       String?  @map("sender_name")
  contentText      String   @map("content_text")
  screenshotOssKey String?  @map("screenshot_oss_key")
  capturedAt       DateTime @map("captured_at")
  employeeId       Int      @map("employee_id")
  employee         Employee @relation(fields: [employeeId], references: [id])

  @@map("messages")
}

model Call {
  id              Int      @id @default(autoincrement())
  orderId         Int?     @map("order_id")
  order           Order?   @relation(fields: [orderId], references: [id])
  employeeId      Int      @map("employee_id")
  employee        Employee @relation(fields: [employeeId], references: [id])
  phone           String
  contactName     String?  @map("contact_name") // 通讯录里的姓名（移动端采集时带上，可能为空）
  direction       String   // 'in' | 'out'
  callStatus      String   @default("answered") @map("call_status") // 'answered' | 'missed' | 'rejected' | 'outgoing_unanswered'
  durationSec     Int      @map("duration_sec")
  startedAt       DateTime @map("started_at")
  recordingOssKey String?  @map("recording_oss_key")
  asrText         String?  @map("asr_text")
  asrStatus       String   @default("no_recording") @map("asr_status") // 'no_recording' | 'pending' | 'processing' | 'done' | 'failed' | 'requires_manual'
  // Fun-ASR (DashScope) 任务追踪
  dashscopeTaskId String?  @map("dashscope_task_id")
  asrResultJson   Json?    @map("asr_result_json")
  asrFinishedAt   DateTime? @map("asr_finished_at")

  @@map("calls")
}

model Command {
  id          Int       @id @default(autoincrement())
  target      String    // 'ext' | 'tray'
  action      String    // 'claim' | 'fill_form'
  payloadJson Json      @map("payload_json")
  status      String    @default("pending") // 'pending' | 'done' | 'failed' | 'requires_manual'
  createdAt   DateTime  @default(now()) @map("created_at")
  executedAt  DateTime? @map("executed_at")

  @@map("commands")
}

model AiSummary {
  id        Int      @id @default(autoincrement())
  orderId   Int      @map("order_id")
  order     Order    @relation(fields: [orderId], references: [id])
  callId    Int?     @map("call_id")  // 关联到具体某次通话；message/full 类型可为 null
  type      String   // 'call' | 'message' | 'full'
  content   String
  model     String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([callId])
  @@map("ai_summaries")
}
