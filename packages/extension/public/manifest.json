{
  "manifest_version": 3,
  "name": "寰宇医道 - 泰康助手探针",
  "version": "1.2.13",
  "description": "连接泰康系统与寰宇医道中枢",
  "key": "",
  "update_url": "http://47.95.14.233:9093/ext/update.xml",
  "host_permissions": [
    "*://ccm.taikang.com/*"
  ],
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "alarms",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "background.global.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://ccm.taikang.com/*"],
      "js": ["content.global.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["pageProbe.global.js"],
      "matches": ["*://ccm.taikang.com/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "寰宇医道探针"
  }
}
